# Copia questo file in .env e imposta il percorso locale ai dati
# NON committare mai il file .env

# Radice di Google Drive ("Il mio Drive"): ogni stagione usa poi il proprio
# base_path_drive da config/seasons.csv (stessa logica di Colab).
VOLLEY_DRIVE_ROOT=/percorso/locale/a/Il mio Drive

# Legacy (usata solo se VOLLEY_DRIVE_ROOT manca): cartella partite di UNA stagione.
# VOLLEY_DATA_PATH=/percorso/locale/alla/cartella/partite
